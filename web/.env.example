# Copy to .env.local for local dev, and add the same key in Vercel → Settings → Environment Variables.

# Formspree form id, the part after /f/ in the endpoint.
# Optional: contact-form.tsx already ships Film's own id as the default, so the
# form works without this. Set it only to point the form at a different inbox.
NEXT_PUBLIC_FORMSPREE_ID=

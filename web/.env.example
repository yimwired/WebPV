# Copy to .env.local for local dev, and add the same key in Vercel → Settings → Environment Variables.

# Formspree form id, the part after /f/ in the endpoint (e.g. "xdkoblqr").
# Public by design: it ends up in the form action either way.
# Leave it unset and the contact form is hidden, so the footer falls back to
# its mailto and copy-email buttons.
NEXT_PUBLIC_FORMSPREE_ID=

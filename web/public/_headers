# Cloudflare Pages reads this file from the deploy root and applies it to
# matching paths. Order matters: later rules win.

# Next's generated OG route exports as an extensionless file, so Pages cannot
# infer the type from the name and would serve it as text. Facebook, X and LINE
# all drop a share image whose Content-Type is wrong.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Hashed build assets never change under the same name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Lab cards carry a content hash in the query string (see lib/lab-cards.ts), so
# a reshoot is a different URL and a long cache can never serve a stale one.
# Scoped to the image folder on purpose: /labs/* would also match the lab pages
# themselves, and a cached page would survive a deploy.
/labs/cards/*
  Cache-Control: public, max-age=31536000, immutable

# Project imagery has no hash, so it stays on a day: long enough that repeat
# visits are free, short enough that a swap shows up without a purge.
/projects/*
  Cache-Control: public, max-age=86400
/labs/trine-hand.webp
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
